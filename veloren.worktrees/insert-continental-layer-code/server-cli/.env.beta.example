# Copy to .env and replace every placeholder before deployment.
VELOREN_AUTH_SERVER_URL=https://beta-auth.example.com
VELOREN_SERVER_NAME=Veloren Public Beta
VELOREN_MAX_PLAYERS=50
VELOREN_SOLANA_RPC_URL=https://api.devnet.solana.com
VELOREN_MARKETPLACE_SELLER=REPLACE_WITH_SELLER_PUBLIC_KEY
VELOREN_MARKETPLACE_LAND_MINT=REPLACE_WITH_SPL_MINT
VELOREN_MARKETPLACE_PARCEL_ID=DEV-LAND-0002
VELOREN_MARKETPLACE_PRICE_LAMPORTS=1000000
VELOREN_MARKETPLACE_MINT_DECIMALS=0
# Absolute path to a chmod 600 JSON keypair file on the VPS.
VELOREN_MARKETPLACE_SELLER_KEYPAIR_FILE=/opt/veloren/secrets/marketplace-seller.json
