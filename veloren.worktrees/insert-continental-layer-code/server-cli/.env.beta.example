# Copy to .env and replace every placeholder before deployment.
VELOREN_AUTH_SERVER_URL=https://beta-auth.example.com
VELOREN_SERVER_NAME=Veloren Public Beta
VELOREN_MAX_PLAYERS=50
VELOREN_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
# Set this to the current Helius Devnet RPC URL on the VPS. Do not commit API keys.
SOLANA_RPC_URL=https://api.devnet.solana.com
VGLD_MINT_ADDRESS=AkzXGYuYBC9wE36N4Zxp3jNfhZEHmyGnWGkrC9ciuw9v
VGLD_DECIMALS=9
VGLD_SYMBOL=VGLD
VGLD_NAME=Veloren Gold
VELOREN_VGLD_NETWORK=devnet
# Keep this aligned with SOLANA_RPC_URL above.
VELOREN_VGLD_RPC_URL=https://api.devnet.solana.com
VELOREN_VGLD_MINT=AkzXGYuYBC9wE36N4Zxp3jNfhZEHmyGnWGkrC9ciuw9v
# Public key that receives VGLD deposits. Its associated token account is created
# by the user's wallet transaction when needed.
VELOREN_VGLD_TREASURY=REPLACE_WITH_TREASURY_PUBLIC_KEY
VELOREN_MARKETPLACE_SELLER=REPLACE_WITH_SELLER_PUBLIC_KEY
VELOREN_MARKETPLACE_LAND_MINT=REPLACE_WITH_SPL_MINT
VELOREN_MARKETPLACE_PARCEL_ID=DEV-LAND-0002
VELOREN_MARKETPLACE_PRICE_LAMPORTS=1000000
VELOREN_MARKETPLACE_MINT_DECIMALS=0
# Absolute path to a chmod 600 JSON keypair file on the VPS.
VELOREN_MARKETPLACE_SELLER_KEYPAIR_FILE=/opt/veloren/secrets/marketplace-seller.json

# Never enable the local VGLD property test purchase mode on beta/production.
# VELOREN_PROPERTY_VGLD_PURCHASE_TEST_MODE=1
