# Environment split for local dev / beta / production
VELOREN_ENVIRONMENT=dev

# Auth behavior:
#   dev   -> wallet/local auth
#   beta  -> remote auth server
#   prod  -> remote auth server
# You can override directly with VELOREN_AUTH_MODE as well.
VELOREN_AUTH_MODE=wallet
VELOREN_AUTH_SERVER_URL=https://auth.example.com

# Public beta/prod server identity
VELOREN_SERVER_NAME=Veloren Local Test Server
VELOREN_MAX_PLAYERS=100
