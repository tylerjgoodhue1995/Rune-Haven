# Veloren Marketplace Service Configuration
# Copy this file to marketplace.env and update the values

# VGLD Token Configuration
VELOREN_VGLD_MINT=your-vglm-mint-address
VELOREN_VGLD_TREASURY=your-vglm-treasury-address

# Database connection
# DATABASE_URL=sqlite://./marketplace-data/marketplace.db

# Server bind address
MARKETPLACE_BIND=0.0.0.0:19254

# Environment
VELOREN_ENVIRONMENT=prod

# Seller keypair path (place in secrets/marketplace-seller.json)
MARKETPLACE_SELLER_KEYPAIR=./secrets/marketplace-seller.json

# Land mint configuration
LAND_MINT_ADDRESS=your-land-mint-address
