# Veloren Game Server Configuration - Local Testing
# For VPS deployment, use .env instead

# Authentication Mode - local for testing (no auth server needed)
VELOREN_AUTH_MODE=local

# Authentication Server URL - not needed for local mode
# VELOREN_AUTH_SERVER_URL=http://52.247.50.106:19253

# Server Name
VELOREN_SERVER_NAME=Runehaven Local Test Server

# Maximum Players
VELOREN_MAX_PLAYERS=10

# World Seed (optional, defaults to 130626853)
VELOREN_WORLD_SEED=130626853

# Day Length in minutes (optional, defaults to 24.0)
VELOREN_DAY_LENGTH=24.0
