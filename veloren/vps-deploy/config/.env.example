# Veloren Game Server Configuration
# Copy this file to .env and update the values

# Authentication Mode
VELOREN_AUTH_MODE=remote
VELOREN_ALPHA_ACCESS_PATH=./alpha-access.json

# Authentication Server URL (update with your VPS IP)
VELOREN_AUTH_SERVER_URL=http://52.247.50.106:19253

# Server Name
VELOREN_SERVER_NAME=Runehaven Veloren Server

# Maximum Players
VELOREN_MAX_PLAYERS=100

# World Seed (optional, defaults to 130626853)
# VELOREN_WORLD_SEED=130626853

# Day Length in minutes (optional, defaults to 24.0)
# VELOREN_DAY_LENGTH=24.0
