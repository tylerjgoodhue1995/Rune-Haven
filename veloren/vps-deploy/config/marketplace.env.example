VELOREN_MARKETPLACE_BIND=0.0.0.0:19254
VELOREN_SOLANA_RPC_URL=https://api.devnet.solana.com

# Public seller address. Must match the keypair below.
VELOREN_MARKETPLACE_SELLER=

# JSON byte array from a devnet-only seller keypair file.
# Never commit a real keypair or place one in source control.
VELOREN_MARKETPLACE_SELLER_KEYPAIR=

VELOREN_MARKETPLACE_PARCEL_ID=DEV-LAND-0002
VELOREN_MARKETPLACE_LAND_MINT=
VELOREN_MARKETPLACE_PRICE_LAMPORTS=1000000
VELOREN_MARKETPLACE_MINT_DECIMALS=0
