# Veloren Authentication Service Configuration
# Copy this file to auth.env and update the values

# Database connection string
# DATABASE_URL=sqlite://./auth-data/auth.db

# Server bind address
BETA_AUTH_BIND=127.0.0.1:19253

# Environment (dev, beta, prod)
VELOREN_ENVIRONMENT=prod

# Secret key for session management (generate a secure random string)
# AUTH_SECRET_KEY=your-secret-key-here

# Optional: External auth providers
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Shared alpha maintenance/allowlist state (also used by the game server)
BETA_ALPHA_ACCESS_PATH=./alpha-access.json
BETA_ALPHA_ADMIN_WALLETS=EiL5hGfzLAyCah2GMrxFz47HPLwgK6CQtS1CL1gWxQF8
