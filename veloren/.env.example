# Environment split for local dev / beta / production
VELOREN_ENVIRONMENT=dev

# Auth behavior:
#   dev   -> wallet/local auth
#   beta  -> remote auth server
#   prod  -> remote auth server
# You can override directly with VELOREN_AUTH_MODE as well.
VELOREN_AUTH_MODE=wallet
VELOREN_AUTH_SERVER_URL=https://auth.example.com

# Public beta/prod server identity
VELOREN_SERVER_NAME=Veloren Local Test Server
VELOREN_MAX_PLAYERS=100

# VGLD Devnet configuration (configuration only; ledger integration comes later)
VELOREN_VGLD_NETWORK=devnet
VELOREN_VGLD_RPC_URL=https://api.devnet.solana.com
VELOREN_VGLD_MINT=AkzXGYuYBC9wE36N4Zxp3jNfhZEHmyGnWGkrC9ciuw9v

# Compatibility names used by the beta deployment environment.
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
VGLD_MINT_ADDRESS=AkzXGYuYBC9wE36N4Zxp3jNfhZEHmyGnWGkrC9ciuw9v
VGLD_DECIMALS=9
VGLD_SYMBOL=VGLD
VGLD_NAME=Veloren Gold

# Development-only property purchase test mode.
# Leave disabled in beta/production; this debits the local ledger and assigns
# mock development land without creating a blockchain transaction.
# VELOREN_PROPERTY_VGLD_PURCHASE_TEST_MODE=1
# Solana token deposit destination used by the automatic Phantom VGLD bridge.
# The treasury token account owner must have an associated token account for the VGLD mint.
VELOREN_VGLD_TREASURY=
